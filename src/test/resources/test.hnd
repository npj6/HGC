

"TEST_ROLE1" = ("A" | "C");

"TEST" = "TEST_ROLE1" @ 5;
"TEST" = "B"x1 @ 5;
"TEST" = ("A" | "B")!x1 @ 5;
"TEST" = ("A" | "B" | "C") @ 17;

"TEST_ROLE2" = ("A" | "TEST_ROLE1" | "C");

"TEST" = "A" & "B" @ 5;
"TEST" = "A" | "B" @ 5;
"TEST" = "A" ^& "B" @ 5;
"TEST" = ("TEST_ROLE2") @ 7;

"TEST_ROLE3" = "A" ;

"TEST" = "A" & "B" ^& "A" & "B" | "A" & "B" ^& "A" & "B" @ 5;
"TEST" = ("A" ^& "B") & ("A" ^& "B") | ("A" ^& "B") & ("A" ^& "B") @ 5;
"TEST" = ("A" | "B") & ("A" | "B") ^& ("A" | "B") & ("A" | "B") @ 5;
"TEST" = ("A" & "B" | "A" & "B") ^& ("A" & "B" | "A" & "B") @ 5;
"TEST" = ("A" ^& "B" | "A" ^& "B") & ("A" ^& "B" | "A" ^& "B") @ 5;
"TEST" = ("A" | "B") ^& ("A" | "B") & ("A" | "B") ^& ("A" | "B") @ 5;

"TEST" = "A" @ 5 & "B" @ 6;
"TEST" = "A" @ 5 | "B" @ 6;
"TEST" = ("A" @ 5 | "B" @ 6) & ("A" @ 5 | "B" @ 6);
"TEST" = "A" @ 5 & "B" @ 6 | "A" @ 5 & "B" @ 6;

"TEST" = (("A" | "B" | "C") & "A"!x1 ^& "B" | "C"!x1 @ 7
        | ("A" | "B" | "C") & "A"!x1 ^& "B" | "C"!x1 @ 7 ) 
       & (("A" | "B" | "C") & "A"!x1 ^& "B" | "C"!x1 @ 7
        | ("A" | "B" | "C") & "A"!x1 ^& "B" | "C"!x1 @ 7 )
    |    (("A" | "B" | "C") & "A"!x1 ^& "B" | "C"!x1 @ 7
        | ("A" | "B" | "C") & "A"!x1 ^& "B" | "C"!x1 @ 7 ) 
       & (("A" | "B" | "C") & "A"!x1 ^& "B" | "C"!x1 @ 7
        | ("A" | "B" | "C") & "A"!x1 ^& "B" | "C"!x1 @ 7 )
